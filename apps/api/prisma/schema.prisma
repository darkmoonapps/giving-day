generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  he
  en
}

enum ThemePref {
  system
  light
  dark
}

enum AuthProvider {
  google
  facebook
  apple
}

enum CityRole {
  coordinator
  volunteer
}

enum MembershipStatus {
  pending
  active
  paused
  removed
}

model City {
  id         String    @id @default(uuid()) @db.Uuid
  slug       String    @unique
  nameHe     String
  nameEn     String
  timezone   String    @default("Asia/Jerusalem")
  isActive   Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  invites     CityInvite[]
  memberships CityMembership[]

  @@map("cities")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firstName    String?
  lastName     String?
  phone        String?
  email        String?    @db.Citext
  birthDate    DateTime?  @db.Date
  locale       Locale     @default(he)
  themePref    ThemePref  @default(system)
  isSuperAdmin Boolean    @default(false)
  onboardedAt  DateTime?
  lastLoginAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  identities  AuthIdentity[]
  sessions    Session[]
  memberships CityMembership[]
  invitesCreated CityInvite[]

  @@map("users")
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("auth_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model CityInvite {
  id          String    @id @default(uuid()) @db.Uuid
  cityId      String    @db.Uuid
  role        CityRole
  tokenHash   String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime?
  maxUses     Int?
  usedCount   Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  city      City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdBy User             @relation(fields: [createdById], references: [id])
  memberships CityMembership[]

  @@map("city_invites")
}

model CityMembership {
  id               String           @id @default(uuid()) @db.Uuid
  cityId           String           @db.Uuid
  userId           String           @db.Uuid
  role             CityRole
  status           MembershipStatus @default(pending)
  inviteId         String?          @db.Uuid
  approvedById     String?          @db.Uuid
  approvedAt       DateTime?
  homeArea         String?
  coordinatorNotes String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  city   City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invite CityInvite? @relation(fields: [inviteId], references: [id])

  @@unique([cityId, userId])
  @@map("city_memberships")
}
