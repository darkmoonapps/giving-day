  "info": {
    "title": "Giving Day API",
    "description": "REST API for the Giving Day volunteer management app",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "DatabaseHealthDto": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "connected"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "example": "healthy"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-15T10:00:00.000Z"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseHealthDto"
          }
        },
        "required": [
          "status",
          "timestamp",
          "database"
        ]
      },
      "CitySettingsResponseDto": {
        "type": "object",
        "properties": {
          "cityId": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "centerAddress": {
            "type": "string",
            "example": "10 Warehouse Rd, Holon"
          },
          "centerLat": {
            "type": "number",
            "example": 32.0114
          },
          "centerLng": {
            "type": "number",
            "example": 34.7748
          },
          "defaultStartTime": {
            "type": "string",
            "example": "09:00:00"
          },
          "defaultEndTime": {
            "type": "string",
            "example": "14:00:00"
          },
          "confirmReminderAfterHours": {
            "type": "number",
            "example": 24
          },
          "unpickedPushMinutesBeforeEnd": {
            "type": "number",
            "example": 60
          },
          "missingFinalStatusWaitHours": {
            "type": "number",
            "example": 72
          },
          "defaultLocale": {
            "type": "string",
            "example": "he",
            "enum": [
              "he",
              "en"
            ]
          },
          "defaultTheme": {
            "type": "string",
            "example": "wisteria-mint"
          },
          "orgName": {
            "type": "string",
            "example": "Latet Holon",
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "example": null,
            "nullable": true
          },
          "extra": {
            "type": "object",
            "example": {
              "mapZoom": 14
            }
          }
        },
        "required": [
          "cityId",
          "centerAddress",
          "centerLat",
          "centerLng",
          "defaultStartTime",
          "defaultEndTime",
          "confirmReminderAfterHours",
          "unpickedPushMinutesBeforeEnd",
          "missingFinalStatusWaitHours",
          "defaultLocale",
          "defaultTheme",
          "orgName",
          "logoUrl",
          "extra"
        ]
      },
      "CityJoinLinkStatusDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "example": "volunteer",
            "enum": [
              "coordinator",
              "volunteer"
            ]
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-28T09:00:00.000Z",
            "nullable": true
          },
          "usedCount": {
            "type": "number",
            "example": 0
          }
        },
        "required": [
          "role",
          "active",
          "createdAt",
          "usedCount"
        ]
      },
      "CityJoinLinksResponseDto": {
        "type": "object",
        "properties": {
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CityJoinLinkStatusDto"
            }
          }
        },
        "required": [
          "links"
        ]
      },
      "CityJoinLinkCreatedDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "example": "volunteer",
            "enum": [
              "coordinator",
              "volunteer"
            ]
          },
          "token": {
            "type": "string",
            "example": "fake-join-token"
          },
          "url": {
            "type": "string",
            "example": "http://localhost:3000/join/fake-join-token"
