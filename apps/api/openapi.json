{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Get API and database health",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Giving Day API",
    "description": "REST API for the Giving Day volunteer management app",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "DatabaseHealthDto": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "connected"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "example": "healthy"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-15T10:00:00.000Z"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseHealthDto"
          }
        },
        "required": [
          "status",
          "timestamp",
          "database"
        ]
      }
    }
  }
}
