  "info": {
    "title": "Giving Day API",
    "description": "REST API for the Giving Day volunteer management app",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "DatabaseHealthDto": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "connected"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "example": "healthy"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-15T10:00:00.000Z"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseHealthDto"
          }
        },
        "required": [
          "status",
          "timestamp",
          "database"
        ]
      },
      "CitySettingsResponseDto": {
        "type": "object",
        "properties": {
          "cityId": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "centerAddress": {
            "type": "string",
            "example": "10 Warehouse Rd, Holon"
          },
          "centerLat": {
            "type": "number",
            "example": 32.0114
          },
          "centerLng": {
            "type": "number",
            "example": 34.7748
          },
          "defaultStartTime": {
            "type": "string",
            "example": "09:00:00"
          },
          "defaultEndTime": {
            "type": "string",
            "example": "14:00:00"
          },
          "confirmReminderAfterHours": {
            "type": "number",
            "example": 24
          },
          "unpickedPushMinutesBeforeEnd": {
            "type": "number",
            "example": 60
          },
          "missingFinalStatusWaitHours": {
            "type": "number",
            "example": 72
          },
          "defaultLocale": {
            "type": "string",
            "example": "he",
            "enum": [
              "he",
              "en"
            ]
          },
          "defaultTheme": {
            "type": "string",
            "example": "wisteria-mint"
          },
          "orgName": {
            "type": "string",
            "example": "Latet Holon",
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "example": null,
            "nullable": true
          },
          "extra": {
            "type": "object",
            "example": {
              "mapZoom": 14
            }
          }
        },
        "required": [
          "cityId",
          "centerAddress",
          "centerLat",
          "centerLng",
          "defaultStartTime",
          "defaultEndTime",
          "confirmReminderAfterHours",
          "unpickedPushMinutesBeforeEnd",
          "missingFinalStatusWaitHours",
          "defaultLocale",
          "defaultTheme",
          "orgName",
          "logoUrl",
          "extra"
        ]
      },
      "CityJoinLinkDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "example": "volunteer",
            "enum": [
              "coordinator",
              "volunteer"
            ]
          },
          "token": {
            "type": "string",
            "example": "fake-join-token"
          },
          "url": {
            "type": "string",
            "example": "http://localhost:3000/join/fake-join-token"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-28T09:00:00.000Z"
          },
          "usedCount": {
            "type": "number",
            "example": 0
          }
        },
        "required": [
          "role",
          "token",
          "url",
          "createdAt",
          "usedCount"
        ]
      },
      "CityJoinLinksResponseDto": {
        "type": "object",
        "properties": {
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CityJoinLinkDto"
            }
          }
        },
        "required": [
          "links"
        ]
      },
      "CityCoordinatorDto": {
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid",
            "example": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
          },
          "firstName": {
            "type": "string",
            "example": "Noa",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "example": "Levi",
            "nullable": true
          },
          "email": {
            "type": "string",
            "example": "noa.levi@example.com",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "example": "+972502222222",
            "nullable": true
          },
          "status": {
            "type": "string",
            "example": "active",
            "enum": [
              "pending",
              "active",
              "paused",
              "removed"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-01T09:00:00.000Z"
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-01T09:05:00.000Z",
            "nullable": true
          }
        },
        "required": [
          "membershipId",
          "userId",
          "firstName",
          "lastName",
          "email",
          "phone",
          "status",
          "createdAt",
          "approvedAt"
        ]
      },
      "CityCoordinatorsResponseDto": {
        "type": "object",
        "properties": {
          "coordinators": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CityCoordinatorDto"
            }
          }
        },
        "required": [
          "coordinators"
        ]
      }
    }
  }
}
