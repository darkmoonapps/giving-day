DATABASE_URL="postgresql://givingday:givingday_dev@localhost:5432/givingday?schema=public"
PORT=3001
CORS_ORIGINS=http://localhost:3000
# EU DSN from https://de.sentry.io — leave empty to disable Sentry (no-op)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# OAuth Credentials (required for social login - no real secrets in repo)
# Google: Create OAuth 2.0 Client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Facebook: Create app at https://developers.facebook.com/apps/
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# JWT Configuration (generate secure random values for production)
JWT_SECRET=development-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=development-refresh-token-secret-change-in-production

# API and Frontend URLs (used for OAuth callbacks)
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Web Push VAPID keys (free, no third-party push vendor). Leave empty to use
# the log/no-op provider in development and tests.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com
