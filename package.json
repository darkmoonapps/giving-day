{
  "name": "giving-day",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Volunteer management app for monthly food-package distribution days",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --filter @giving-day/web --filter @giving-day/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @giving-day/shared --filter @giving-day/ui build && pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @giving-day/api prisma:generate",
    "test": "pnpm -r --if-present test",
    "test:ci": "pnpm -r --if-present test:ci",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "codegen": "pnpm --filter @giving-day/shared build && pnpm --filter @giving-day/api openapi:generate && pnpm --filter @giving-day/web codegen",
    "codegen:check": "bash scripts/check-generated.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
