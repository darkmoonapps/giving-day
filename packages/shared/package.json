{
  "name": "@giving-day/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node --input-type=commonjs -e \"require('./dist/index.js')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  }
}
